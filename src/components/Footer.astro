---
import Icon from './Icon.astro';
import { profile, tagline } from '../data/profile';

const currentYear = new Date().getFullYear();

const navItems = [
  { href: '/projects/', label: 'Projects' },
  { href: '/homelab/', label: 'Homelab' },
  { href: '/blog/', label: 'Blog' },
  { href: '/resume/', label: 'Resume' },
  { href: '/now/', label: 'Now' },
];
---

<footer class="relative z-10 border-t border-border">
  <div class="mx-auto max-w-5xl px-6 py-14">
    <div class="grid gap-10 md:grid-cols-[1.6fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-flex items-center gap-2.5 text-sm font-bold tracking-tight">
          <span class="flex h-7 w-7 items-center justify-center rounded-md border border-primary/25 bg-primary/10 text-primary">
            <Icon name="terminal" size={14} strokeWidth={2.2} />
          </span>
          <span class="mono">
            {profile.brand.lead} <span class="text-primary">{profile.brand.accent}</span>
          </span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">{tagline}</p>
        <p class="mono mt-5 flex items-center gap-2 text-[11px] text-subtle">
          <span class="status-dot"></span>
          Static build &middot; Docker + Nginx
        </p>
      </div>

      <div>
        <p class="eyebrow">Navigate</p>
        <ul class="mt-4 space-y-2.5">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-muted transition-colors hover:text-text"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="eyebrow">Connect</p>
        <ul class="mt-4 space-y-2.5">
          <li>
            <a
              href={profile.links.github}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-text"
            >
              <Icon name="github" size={15} class="text-subtle transition-colors group-hover:text-primary" />
              GitHub
            </a>
          </li>
          <li>
            <a
              href={profile.links.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-text"
            >
              <Icon name="linkedin" size={15} class="text-subtle transition-colors group-hover:text-primary" />
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href={`mailto:${profile.email}`}
              class="group inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-text"
            >
              <Icon name="mail" size={15} class="text-subtle transition-colors group-hover:text-primary" />
              Email
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-subtle">
        &copy; {currentYear} {profile.siteName} &middot; {profile.name}. All rights reserved.
      </p>
      <p class="mono text-[11px] text-subtle">
        Built with Astro &middot; self-hosted
      </p>
    </div>
  </div>
</footer>
