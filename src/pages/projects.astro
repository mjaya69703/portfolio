---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';

const projects = [
  {
    name: 'Homelab Infrastructure',
    description:
      'Self-hosted infrastructure on a Mini PC running Proxmox VE with LXC containers. Hosts 12+ services including 5+ web apps, a Grafana + Prometheus monitoring stack, Docker workloads, and a centralized database — exposed through Cloudflare Tunnel with zero open inbound ports.',
    technologies: ['Proxmox', 'LXC', 'Docker', 'Nginx', 'Cloudflare Tunnel', 'Grafana', 'Prometheus', 'MariaDB'],
    status: 'Active',
    github: null,
    demo: null,
    link: '/homelab/',
    linkLabel: 'View Setup',
  },
  {
    name: 'NexaCampus',
    description:
      'Comprehensive academic information system (SIAKAD PT) built with Laravel 12 & Livewire 4. Manages academics, learning, admissions, finance, student services, HR, and academic oversight in one platform.',
    technologies: ['Laravel', 'Livewire', 'Tailwind CSS', 'MySQL'],
    status: 'Active',
    github: 'https://github.com/mjaya69703/nexacampus',
    demo: 'https://nexacampus.idev-fun.org',
  },
  {
    name: 'Neco Siakad',
    description:
      'Open-source academic system for higher education. Production-ready SIAKAD platform with 47 GitHub stars and 16 forks.',
    technologies: ['Laravel', 'Blade', 'HTML', 'CSS'],
    status: 'Active',
    github: 'https://github.com/mjaya69703/siakad-pt.internal-dev.id',
    demo: 'https://siakad-pt.idev-fun.org',
  },
  {
    name: 'Laraflare',
    description:
      'Laravel Domain Manager with Cloudflare API. A tool for managing domains and DNS records through Cloudflare integration.',
    technologies: ['Laravel', 'Blade', 'Cloudflare API'],
    status: 'Completed',
    github: 'https://github.com/mjaya69703/laraflare',
    demo: null,
  },
  {
    name: 'Arpotret',
    description:
      'Open-source photography booking web application. System for managing bookings, portfolios, and photographer-client interactions.',
    technologies: ['Laravel', 'Blade', 'JavaScript'],
    status: 'Completed',
    github: 'https://github.com/mjaya69703/www.arpotret.biz.id',
    demo: 'https://arpotret.idev-fun.org',
  },
];

const statusStyles: Record<string, { badge: string; dot: string }> = {
  Active: { badge: 'badge-success', dot: 'bg-success' },
  Completed: { badge: 'badge-primary', dot: 'bg-primary' },
  Exploring: { badge: 'badge-warning', dot: 'bg-warning' },
};

const activeCount = projects.filter((project) => project.status === 'Active').length;
---

<BaseLayout title={`Projects - ${profile.siteName}`} description="Infrastructure projects, automation tools, and open-source systems built by Muhamad Jaya Kusuma.">
  <section class="px-6 pb-16 pt-14 md:pb-24 md:pt-20">
    <div class="mx-auto max-w-5xl">
      <div class="flex flex-col gap-8 border-b border-border pb-8 md:flex-row md:items-end md:justify-between" data-reveal>
        <div>
          <p class="eyebrow eyebrow-line">01 / Work</p>
          <h1 class="mt-3 text-4xl font-semibold tracking-[-0.04em] text-text md:text-5xl">Projects</h1>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted sm:text-base">
            What has been built, what problems it solves, and the technologies behind it.
          </p>
        </div>

        <div class="flex gap-8">
          <div>
            <p class="mono text-2xl font-semibold text-text">{String(projects.length).padStart(2, '0')}</p>
            <p class="mt-0.5 text-[10px] uppercase tracking-[0.16em] text-subtle">Projects</p>
          </div>
          <div>
            <p class="mono text-2xl font-semibold text-success">{String(activeCount).padStart(2, '0')}</p>
            <p class="mt-0.5 text-[10px] uppercase tracking-[0.16em] text-subtle">Active</p>
          </div>
        </div>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {projects.map((project, index) => {
          const style = statusStyles[project.status] ?? statusStyles.Exploring;
          return (
            <article
              class:list={[
                'card group flex flex-col',
                index === 0 && 'md:col-span-2 md:p-7',
              ]}
              data-reveal
              style={`--reveal-delay: ${Math.min(index, 4) * 60}ms`}
            >
              <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                  <span class="mono text-[11px] text-subtle">{String(index + 1).padStart(2, '0')}</span>
                  <span class="h-px w-6 bg-border"></span>
                  <span class="mono text-[10px] uppercase tracking-[0.16em] text-subtle">
                    {index === 0 ? 'Featured' : 'Project'}
                  </span>
                </div>
                <span class:list={['badge shrink-0', style.badge]}>
                  <span class:list={['h-1.5 w-1.5 rounded-full', style.dot]}></span>
                  {project.status}
                </span>
              </div>

              <h2
                class:list={[
                  'mt-5 font-semibold tracking-tight text-text',
                  index === 0 ? 'text-2xl' : 'text-lg',
                ]}
              >
                {project.name}
              </h2>
              <p class:list={['mt-2 leading-relaxed text-muted', index === 0 ? 'max-w-3xl text-sm sm:text-base' : 'text-sm']}>
                {project.description}
              </p>

              <div class="mt-4 flex flex-wrap gap-2">
                {project.technologies.map((tech) => (
                  <span class="badge mono">{tech}</span>
                ))}
              </div>

              <div class="mt-6 flex flex-wrap items-center gap-5 border-t border-border pt-5 md:mt-auto">
                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-arrow"
                  >
                    <Icon name="github" size={14} />
                    Source
                  </a>
                )}
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-arrow"
                  >
                    <Icon name="external-link" size={14} />
                    Live demo
                  </a>
                )}
                {project.link && (
                  <a href={project.link} class="link-arrow">
                    <Icon name="arrow-up-right" size={14} />
                    {project.linkLabel ?? 'Details'}
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>

      <div class="mt-12 flex justify-center" data-reveal>
        <a
          href={profile.links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
        >
          <Icon name="github" size={15} />
          More on GitHub
          <Icon name="arrow-up-right" size={14} class="text-subtle" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
