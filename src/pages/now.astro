---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';

const learning = [
  {
    icon: 'box',
    title: 'Kubernetes',
    description: 'Building on the KodeKloud certification with cluster operations, manifests, and troubleshooting',
  },
  {
    icon: 'pen-tool',
    title: 'Infrastructure Automation',
    description: 'Practicing Ansible, Bash, and GitHub Actions for repeatable provisioning and operations',
  },
  {
    icon: 'cpu',
    title: 'AI Agents',
    description: 'Experimenting with self-hosted AI agents and operational workflows',
  },
];

const projects = [
  {
    name: 'NexaCampus',
    href: '/projects/',
    status: 'success',
    meta: 'Active project',
  },
  {
    name: 'Homelab Improvements',
    href: '/homelab/',
    status: 'warning',
    meta: 'Ongoing',
  },
  {
    name: profile.siteName,
    href: null,
    status: 'success',
    meta: 'This site',
  },
];
---

<BaseLayout
  title={`Now - ${profile.siteName}`}
  description={`Current snapshot of what ${profile.name} (${profile.alias}) is working on, learning, and interested in`}
>
  <section class="px-6 pb-16 pt-14 md:pb-24 md:pt-20">
    <div class="mx-auto max-w-5xl">
      <div class="flex flex-col gap-5 border-b border-border pb-8 md:flex-row md:items-end md:justify-between" data-reveal>
        <div>
          <p class="eyebrow eyebrow-line">05 / Now</p>
          <h1 class="mt-3 text-4xl font-semibold tracking-[-0.04em] text-text md:text-5xl">Now</h1>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted sm:text-base">
            A snapshot of what I'm working on, learning, and paying attention to right now.
          </p>
        </div>

        <span class="badge mono shrink-0">
          <Icon name="clock" size={12} />
          Updated November 2026
        </span>
      </div>

      <p class="mt-5 flex items-start gap-2 text-xs leading-relaxed text-subtle" data-reveal>
        <Icon name="book-open" size={14} class="mt-0.5 shrink-0" />
        <span>
          This is a{' '}
          <a
            href="https://nownownow.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted underline decoration-border underline-offset-2 transition-colors hover:text-primary-bright"
          >/now page</a
          >. It tells you what I'm up to at this point in my life.
        </span>
      </p>

      <div class="mt-10 grid gap-10 lg:grid-cols-[1.15fr_0.85fr]">
        <div class="space-y-10">
          <!-- Current work -->
          <section data-reveal>
            <div class="flex items-center gap-3">
              <span class="icon-tile">
                <Icon name="briefcase" size={18} />
              </span>
              <div>
                <h2 class="section-title">Current Work</h2>
                <p class="text-xs text-muted">Where the days go</p>
              </div>
            </div>

            <div class="card relative mt-5 overflow-hidden">
              <div class="pointer-events-none absolute -right-16 -top-16 h-40 w-40 rounded-full bg-primary/10 blur-3xl"></div>

              <div class="relative flex flex-wrap items-center gap-3">
                <div class="min-w-0 flex-1">
                  <p class="mono text-[10px] uppercase tracking-[0.16em] text-subtle">Current role</p>
                  <h3 class="mt-1 text-lg font-semibold text-text">{profile.role}</h3>
                  <p class="text-sm text-muted">{profile.company}</p>
                </div>
                <span class="badge badge-success mono">
                  <span class="status-dot status-dot--pulse"></span>
                  active
                </span>
              </div>

              <p class="relative mt-4 text-sm leading-relaxed text-muted">
                Currently working as <strong class="font-medium text-text">{profile.role}</strong> at{' '}
                <strong class="font-medium text-text">{profile.company}</strong>. Provisioning cloud
                and virtualized servers, managing enterprise DNS in F5 BIG-IP ZoneRunner and AWS Route 53,
                administering FortiGate access, and monitoring production services through ELK and
                Grafana.
              </p>

              <div class="relative mt-4 flex flex-wrap gap-2 border-t border-border pt-4">
                <span class="badge mono">ELK Stack</span>
                <span class="badge mono">Huawei Cloud</span>
                <span class="badge mono">GCP</span>
                <span class="badge mono">VMware</span>
                <span class="badge mono">FortiGate</span>
                <span class="badge mono">F5 ZoneRunner</span>
                <span class="badge mono">AWS Route 53</span>
              </div>
            </div>
          </section>

          <!-- Current learning -->
          <section data-reveal>
            <div class="flex items-center gap-3">
              <span class="icon-tile">
                <Icon name="book-open" size={18} />
              </span>
              <div>
                <h2 class="section-title">Current Learning</h2>
                <p class="text-xs text-muted">What is being studied now</p>
              </div>
            </div>

            <div class="mt-5 space-y-3">
              {learning.map((item, index) => (
                <div class="card group flex items-start gap-4" data-reveal style={`--reveal-delay: ${index * 60}ms`}>
                  <span class="icon-tile">
                    <Icon name={item.icon} size={17} />
                  </span>
                  <div>
                    <h3 class="text-sm font-medium text-text">{item.title}</h3>
                    <p class="mt-1 text-xs leading-relaxed text-muted">{item.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>
        </div>

        <div class="space-y-10">
          <!-- Current projects -->
          <section data-reveal>
            <div class="flex items-center gap-3">
              <span class="icon-tile">
                <Icon name="folder" size={18} />
              </span>
              <div>
                <h2 class="section-title">Current Projects</h2>
                <p class="text-xs text-muted">Open loops</p>
              </div>
            </div>

            <div class="mt-5 space-y-3">
              {projects.map((project) =>
                project.href ? (
                  <a href={project.href} class="card card-link group flex items-center justify-between gap-3 p-4">
                    <div class="flex items-center gap-3">
                      <span
                        class:list={[
                          'status-dot',
                          project.status === 'warning' ? 'status-dot--warning' : '',
                        ]}
                      ></span>
                      <div>
                        <p class="text-sm font-medium text-text">{project.name}</p>
                        <p class="mono mt-0.5 text-[10px] text-subtle">{project.meta}</p>
                      </div>
                    </div>
                    <Icon name="arrow-up-right" size={14} class="shrink-0 text-subtle transition-colors group-hover:text-primary-bright" />
                  </a>
                ) : (
                  <div class="card flex items-center justify-between gap-3 p-4">
                    <div class="flex items-center gap-3">
                      <span class="status-dot"></span>
                      <div>
                        <p class="text-sm font-medium text-text">{project.name}</p>
                        <p class="mono mt-0.5 text-[10px] text-subtle">{project.meta}</p>
                      </div>
                    </div>
                    <span class="badge mono">live</span>
                  </div>
                )
              )}
            </div>
          </section>

          <!-- Current interests -->
          <section data-reveal>
            <div class="flex items-center gap-3">
              <span class="icon-tile">
                <Icon name="heart" size={18} />
              </span>
              <div>
                <h2 class="section-title">Current Interests</h2>
                <p class="text-xs text-muted">Topics that keep pulling me in</p>
              </div>
            </div>

            <div class="card mt-5">
              <div class="flex flex-wrap gap-2">
                <span class="badge badge-primary">Cloud Infrastructure</span>
                <span class="badge badge-primary">Site Reliability</span>
                <span class="badge badge-primary">Observability</span>
                <span class="badge badge-primary">Automation</span>
              </div>
              <p class="mt-4 border-t border-border pt-4 text-xs leading-relaxed text-muted">
                Mostly interested in the unglamorous parts: reliability, observability, and making
                repetitive work disappear.
              </p>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
