---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { existsSync } from 'node:fs';
import { profile } from '../data/profile';

const hasResumePdf = existsSync('public/resume.pdf');

const sections = [
  { id: 'summary', label: 'Summary' },
  { id: 'experience', label: 'Experience' },
  { id: 'skills', label: 'Skills' },
  { id: 'education', label: 'Education' },
  { id: 'certifications', label: 'Certifications' },
];

const experience = [
  {
    role: 'IT Operations Center Engineer',
    company: profile.company,
    period: 'Dec 2025 — Present',
    current: true,
    points: [
      'Provision and manage compute instances across Huawei Cloud, Google Cloud Platform (GCP), and VMware vCenter.',
      'Administer FortiGate firewall policies, VPN access, MAC whitelisting, and IPsec/forward traffic logs.',
      'Manage enterprise DNS records (A, CNAME, TXT) in F5 BIG-IP ZoneRunner and AWS Route 53.',
      'Monitor server, service, and microservice health through ELK Stack dashboards, Grafana, and email alerts.',
      'Escalate incidents with Helpdesk, verify transaction impact, and track tickets through resolution.',
    ],
  },
  {
    role: 'Technical Support',
    company: 'PT Qwords Company International',
    period: 'Nov 2023 — Nov 2025',
    current: false,
    points: [
      'Administered Linux (AlmaLinux, Ubuntu, Debian) and Windows Server VPS environments, including Nginx/Apache, PHP, SSL, and DNS.',
      'Handled malware scanning and cleanup, spam and DDoS mitigation, and hosting firewall configuration.',
      'Migrated websites, email, and databases between servers with minimal downtime.',
      'Supported cPanel/WHM, DirectAdmin, database, and email escalations while monitoring server and network stability.',
    ],
  },
  {
    role: 'Computer Laboratory Technician',
    company: 'STMIK IKMI Cirebon',
    period: 'Sep 2021 — Aug 2023',
    current: false,
    points: [
      'Maintained LAN connectivity, lab hardware, and software for computer laboratory operations.',
      'Handled hardware replacement, OS and software updates, and technical support for faculty, staff, and students.',
    ],
  },
];

const skills = [
  {
    title: 'Cloud & Virtualization',
    icon: 'cloud',
    items: ['Huawei Cloud', 'Google Cloud (GCP)', 'VMware vCenter', 'Proxmox', 'Alibaba Cloud', 'Virtualizor'],
  },
  {
    title: 'Infrastructure & OS',
    icon: 'server',
    items: ['Linux (RHEL/AlmaLinux, Debian, Ubuntu)', 'Windows Server', 'Docker', 'Nginx', 'cPanel/WHM', 'DirectAdmin', 'Webuzo'],
  },
  {
    title: 'Networking & Security',
    icon: 'shield',
    items: ['FortiGate (VPN, IPsec, Firewall)', 'F5 BIG-IP ZoneRunner (DNS)', 'AWS Route 53', 'Cloudflare', 'MikroTik', 'UniFi', 'Cisco', 'BIND', 'PowerDNS', 'Wazuh'],
  },
  {
    title: 'Observability',
    icon: 'activity',
    items: ['ELK Stack', 'Kibana', 'Grafana', 'Prometheus', 'Zabbix'],
  },
  {
    title: 'Automation & DevOps',
    icon: 'workflow',
    items: ['Git', 'GitHub Actions', 'CI/CD', 'Bash', 'Python', 'Ansible', 'YAML'],
  },
  {
    title: 'Development & Data',
    icon: 'database',
    items: ['PHP (Laravel)', 'Node.js', 'NestJS', 'JavaScript', 'MySQL', 'PostgreSQL', 'MinIO', 'Nextcloud'],
  },
];

const education = [
  {
    school: 'Universitas Cakrawala',
    program: 'Sistem & Teknologi Informasi',
    period: 'Sep 2024 — Present',
    points: [
      'Back-End Engineer at SGA/BEM Cakrawala University (Jan 2025 — Nov 2025)',
      'Deployed Node.js and Docker-based services (MinIO, Strapi, Vaultwarden)',
      'Built product and category management features for an online sales system with NestJS',
      'Migrated services between servers to improve resource efficiency and performance',
    ],
  },
  {
    school: 'SMK Veteran Cirebon',
    program: 'Teknik Komputer dan Jaringan',
    period: 'Jun 2018 — Jun 2021',
    points: [
      'LKS IT Network System Administrator Competition, Cirebon City Level 2019',
      'Installed and configured Debian Server, DNS, DHCP, SSH, Web, Mail, and Proxy services',
      'Cisco Packet Tracer: subnetting, routing, switching, and VPN',
    ],
  },
];

const certifications = [
  {
    name: 'Crash Course: Kubernetes For Absolute Beginners',
    issuer: 'KodeKloud',
    date: 'Dec 2025',
  },
  {
    name: 'cPanel Professional Certification Exam (CPP)',
    issuer: 'cPanel University',
    date: 'Sep 2024',
  },
  {
    name: 'Docker for the Absolute Beginner - Hands On - DevOps',
    issuer: 'Udemy - KodeKloud Training',
    date: 'Aug 2024',
  },
  {
    name: 'CCNA v7: Enterprise Networking, Security and Automation',
    issuer: 'Cisco Networking Academy',
    date: 'Jun 2022',
  },
  {
    name: 'NDG: Linux Essentials',
    issuer: 'Net Dev Group',
    date: 'Mar 2022',
  },
];
---

<BaseLayout title={`Resume - ${profile.siteName}`} description="Resume of Muhamad Jaya Kusuma — cloud infrastructure, operations, and DevOps.">
  <section class="px-6 pb-16 pt-14 md:pb-24 md:pt-20">
    <div class="mx-auto max-w-5xl">
      <div class="flex flex-col gap-6 border-b border-border pb-8 md:flex-row md:items-end md:justify-between" data-reveal>
        <div>
          <p class="eyebrow eyebrow-line">04 / Resume</p>
          <h1 class="mt-3 text-4xl font-semibold tracking-[-0.04em] text-text md:text-5xl">Resume</h1>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted sm:text-base">
            Professional summary, experience, and the tools behind the work.
          </p>
        </div>

        {hasResumePdf ? (
          <a href="/resume.pdf" class="btn-primary shrink-0" download>
            <Icon name="download" size={16} />
            Download PDF
          </a>
        ) : (
          <span class="badge shrink-0">PDF unavailable</span>
        )}
      </div>

      <div class="mt-10 grid gap-10 lg:grid-cols-[170px_1fr]">
        <aside class="hidden lg:block">
          <nav class="sticky top-24" aria-label="Resume sections">
            <p class="mono text-[10px] uppercase tracking-[0.16em] text-subtle">On this page</p>
            <ul class="mt-3 border-l border-border">
              {sections.map((section) => (
                <li>
                  <a
                    href={`#${section.id}`}
                    class:list={['resume-nav-link', section.id === 'summary' && 'is-active']}
                    data-section={section.id}
                  >
                    {section.label}
                  </a>
                </li>
              ))}
            </ul>

            <div class="mt-7 rounded-lg border border-border bg-card p-4">
              <p class="mono text-[10px] uppercase tracking-[0.16em] text-subtle">Focus</p>
              <div class="mt-3 flex flex-wrap gap-1.5">
                <span class="badge">Cloud</span>
                <span class="badge">SRE</span>
                <span class="badge">DevOps</span>
              </div>
            </div>
          </nav>
        </aside>

        <div class="min-w-0">
          <!-- Summary -->
          <section id="summary" class="scroll-mt-24" data-reveal>
            <div class="flex items-center gap-3">
              <span class="icon-tile">
                <Icon name="file-text" size={18} />
              </span>
              <div>
                <h2 class="section-title">Summary</h2>
                <p class="text-xs text-muted">The short version</p>
              </div>
            </div>

            <div class="card mt-5">
              <p class="text-sm leading-relaxed text-muted">
                {profile.role} with 4+ years across hosting support and production infrastructure
                operations. Hands-on with cloud provisioning on Huawei Cloud, GCP, and VMware
                vCenter; enterprise DNS on F5 BIG-IP ZoneRunner and AWS Route 53; FortiGate firewall and VPN
                administration; and observability with ELK, Grafana, and Prometheus. Focused on
                growing into Cloud Engineering, SRE, and DevOps through automation and reliable
                system design.
              </p>
              <div class="mt-4 flex flex-wrap gap-2 border-t border-border pt-4">
                <span class="badge badge-primary">Cloud</span>
                <span class="badge">SRE</span>
                <span class="badge">DevOps</span>
                <span class="badge">Observability</span>
              </div>
            </div>
          </section>

          <!-- Experience -->
          <section id="experience" class="mt-12 scroll-mt-24" data-reveal>
            <div class="flex items-center gap-3">
              <span class="icon-tile">
                <Icon name="briefcase" size={18} />
              </span>
              <div>
                <h2 class="section-title">Experience</h2>
                <p class="text-xs text-muted">Where the operational work happened</p>
              </div>
            </div>

            <div class="mt-5 space-y-4">
              {experience.map((job) => (
                <div class="card">
                  <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                      <div class="flex flex-wrap items-center gap-2">
                        <h3 class="text-base font-semibold text-text">{job.role}</h3>
                        {job.current && <span class="badge badge-success mono text-[10px]">current</span>}
                      </div>
                      <p class="text-sm text-muted">{job.company}</p>
                    </div>
                    <span class="badge mono shrink-0">{job.period}</span>
                  </div>

                  <ul class="mt-4 space-y-2 border-t border-border pt-4">
                    {job.points.map((point) => (
                      <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                        <Icon name="check" size={14} class="mt-0.5 shrink-0 text-primary" />
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>

          <!-- Skills -->
          <section id="skills" class="mt-12 scroll-mt-24" data-reveal>
            <div class="flex items-center gap-3">
              <span class="icon-tile">
                <Icon name="wrench" size={18} />
              </span>
              <div>
                <h2 class="section-title">Skills</h2>
                <p class="text-xs text-muted">Tools used in practice, not just listed</p>
              </div>
            </div>

            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              {skills.map((group) => (
                <div class="card group">
                  <div class="flex items-center gap-3">
                    <span class="icon-tile">
                      <Icon name={group.icon} size={17} />
                    </span>
                    <h3 class="text-sm font-medium text-text">{group.title}</h3>
                  </div>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {group.items.map((item) => (
                      <span class="badge mono max-w-full whitespace-normal">{item}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- Education -->
          <section id="education" class="mt-12 scroll-mt-24" data-reveal>
            <div class="flex items-center gap-3">
              <span class="icon-tile">
                <Icon name="graduation-cap" size={18} />
              </span>
              <div>
                <h2 class="section-title">Education</h2>
                <p class="text-xs text-muted">Formal background</p>
              </div>
            </div>

            <div class="mt-5 space-y-4">
              {education.map((item) => (
                <div class="card">
                  <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                      <h3 class="text-base font-semibold text-text">{item.school}</h3>
                      <p class="text-sm text-muted">{item.program}</p>
                    </div>
                    <span class="badge mono shrink-0">{item.period}</span>
                  </div>

                  <ul class="mt-4 space-y-2 border-t border-border pt-4">
                    {item.points.map((point) => (
                      <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                        <Icon name="check" size={14} class="mt-0.5 shrink-0 text-primary" />
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>

          <!-- Certifications -->
          <section id="certifications" class="mt-12 scroll-mt-24" data-reveal>
            <div class="flex items-center gap-3">
              <span class="icon-tile">
                <Icon name="award" size={18} />
              </span>
              <div>
                <h2 class="section-title">Certifications</h2>
                <p class="text-xs text-muted">Verified learning</p>
              </div>
            </div>

            <div class="card mt-5 p-0">
              <div class="divide-y divide-border">
                {certifications.map((cert) => (
                  <div class="flex items-start gap-3 px-6 py-4">
                    <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-border bg-elevated text-muted">
                      <Icon name="award" size={15} />
                    </span>
                    <div class="min-w-0 flex-1">
                      <p class="text-sm font-medium leading-snug text-text">{cert.name}</p>
                      <p class="mt-0.5 text-xs text-muted">{cert.issuer}</p>
                    </div>
                    <span class="mono shrink-0 text-[11px] text-subtle">{cert.date}</span>
                  </div>
                ))}
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const navLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-section]'));
  const targets = navLinks
    .map((link) => document.getElementById(link.dataset.section ?? ''))
    .filter((target): target is HTMLElement => Boolean(target));

  if (targets.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          navLinks.forEach((link) => {
            link.classList.toggle('is-active', link.dataset.section === entry.target.id);
          });
        });
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
    );

    targets.forEach((target) => observer.observe(target));
  }
</script>
