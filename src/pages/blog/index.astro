---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { profile } from '../../data/profile';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categoryCounts = posts.reduce<Record<string, number>>((counts, post) => {
  counts[post.data.category] = (counts[post.data.category] ?? 0) + 1;
  return counts;
}, {});

const categories = Object.entries(categoryCounts)
  .sort(([aCategory, aCount], [bCategory, bCount]) => bCount - aCount || aCategory.localeCompare(bCategory))
  .map(([category, count]) => ({ category, count }));

const categoryLimit = 12;
const hasManyCategories = categories.length + 1 > categoryLimit;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const getReadingTime = (body?: string) => {
  const words = body?.trim().split(/\s+/).length ?? 0;
  return Math.max(1, Math.round(words / 200));
};
---

<BaseLayout
  title={`Blog - ${profile.siteName}`}
  description="Notes on infrastructure, reliability, Linux, Docker, and operations."
>
  <section class="px-6 pb-16 pt-14 md:pb-24 md:pt-20">
    <div class="mx-auto max-w-5xl">
      <div class="flex flex-col gap-8 border-b border-border pb-8 md:flex-row md:items-end md:justify-between" data-reveal>
        <div>
          <p class="eyebrow eyebrow-line">03 / Writing</p>
          <h1 class="mt-3 text-4xl font-semibold tracking-[-0.04em] text-text md:text-5xl">Blog</h1>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted sm:text-base">
            What has been learned and how problems were solved — notes from the operations side.
          </p>
        </div>

        <div class="flex gap-8">
          <div>
            <p class="mono text-2xl font-semibold text-text">{String(posts.length).padStart(2, '0')}</p>
            <p class="mt-0.5 text-[10px] uppercase tracking-[0.16em] text-subtle">Posts</p>
          </div>
          <div>
            <p class="mono text-2xl font-semibold text-primary">{String(categories.length).padStart(2, '0')}</p>
            <p class="mt-0.5 text-[10px] uppercase tracking-[0.16em] text-subtle">Categories</p>
          </div>
        </div>
      </div>

      <!-- Categories -->
      <div class="mt-8" aria-label="Filter blog posts by category" data-reveal>
        <div class="flex flex-wrap items-center gap-2" id="category-filters">
          <button
            type="button"
            class="badge category-filter"
            data-category="all"
            data-index="0"
            aria-pressed="true"
            aria-label={`All posts (${posts.length})`}
          >
            All
            <span class="category-count">{posts.length}</span>
          </button>
          {categories.map(({ category, count }, index) => (
            <button
              type="button"
              class="badge category-filter"
              data-category={category}
              data-index={index + 1}
              aria-pressed="false"
              aria-label={`${category} (${count})`}
            >
              {category}
              <span class="category-count">{count}</span>
            </button>
          ))}
          {hasManyCategories && (
            <button type="button" class="category-more" id="category-more" aria-expanded="false">
              More
            </button>
          )}
        </div>
      </div>

      <!-- Posts -->
      <div class="mt-8 space-y-4" id="blog-posts">
        {posts.map((post, index) => (
          <a
            href={`/blog/${post.id}/`}
            class:list={[
              'card card-link blog-post group',
              index === 0 ? 'p-6 md:p-7' : 'p-5',
            ]}
            data-category={post.data.category}
            data-reveal
            style={`--reveal-delay: ${Math.min(index, 5) * 60}ms`}
          >
            <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  {index === 0 && <span class="badge badge-primary mono">Latest</span>}
                  <span class="badge mono">{post.data.category}</span>
                  <span class="mono text-[11px] text-subtle">{formatDate(post.data.date)}</span>
                  <span class="h-1 w-1 rounded-full bg-border"></span>
                  <span class="mono text-[11px] text-subtle">{getReadingTime(post.body)} min read</span>
                </div>

                <h2
                  class:list={[
                    'mt-3 font-semibold tracking-tight text-text transition-colors group-hover:text-primary-bright',
                    index === 0 ? 'text-xl sm:text-2xl' : 'text-base',
                  ]}
                >
                  {post.data.title}
                </h2>
                <p
                  class:list={[
                    'mt-2 leading-relaxed text-muted',
                    index === 0 ? 'max-w-3xl text-sm sm:text-base' : 'text-sm',
                  ]}
                >
                  {post.data.description}
                </p>
              </div>

              <span class="hidden h-8 w-8 shrink-0 items-center justify-center rounded-full border border-border text-muted transition-all group-hover:border-primary/40 group-hover:text-primary-bright md:mt-1 md:flex">
                <Icon name="arrow-up-right" size={15} />
              </span>
            </div>
          </a>
        ))}
      </div>

      <div id="empty-state" class="card mt-4 hidden py-12 text-center">
        <span class="icon-tile mx-auto">
          <Icon name="file-text" size={18} />
        </span>
        <p class="mt-4 text-sm font-medium text-text">No posts in this category yet.</p>
        <p class="mt-1 text-xs text-muted">Try another category or view all posts.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const visibleCategoryLimit = 12;
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.category-filter'));
  const posts = Array.from(document.querySelectorAll<HTMLElement>('.blog-post'));
  const moreButton = document.querySelector<HTMLButtonElement>('#category-more');
  const emptyState = document.querySelector<HTMLElement>('#empty-state');
  let showAllCategories = false;

  const setActiveCategory = (category: string, updateUrl = true) => {
    const selected = category.toLowerCase();

    filters.forEach((filter) => {
      const isActive = filter.dataset.category?.toLowerCase() === selected;
      filter.setAttribute('aria-pressed', String(isActive));
    });

    let visiblePosts = 0;
    posts.forEach((post) => {
      const isMatch = selected === 'all' || post.dataset.category?.toLowerCase() === selected;
      post.classList.toggle('hidden', !isMatch);
      if (isMatch) visiblePosts += 1;
    });

    emptyState?.classList.toggle('hidden', visiblePosts > 0);

    if (!updateUrl) return;

    const url = new URL(window.location.href);
    if (selected === 'all') {
      url.searchParams.delete('category');
    } else {
      url.searchParams.set('category', category);
    }
    window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
  };

  const updateVisibleCategories = () => {
    filters.forEach((filter) => {
      const index = Number(filter.dataset.index ?? 0);
      const isWithinLimit = showAllCategories || index < visibleCategoryLimit;
      filter.classList.toggle('hidden', !isWithinLimit);
    });

    if (!moreButton) return;

    const canExpand = filters.length > visibleCategoryLimit;
    moreButton.classList.toggle('hidden', !canExpand);
    moreButton.textContent = showAllCategories ? 'Less' : 'More';
    moreButton.setAttribute('aria-expanded', String(showAllCategories));
  };

  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      setActiveCategory(filter.dataset.category ?? 'all');
    });
  });

  moreButton?.addEventListener('click', () => {
    showAllCategories = !showAllCategories;
    updateVisibleCategories();
  });

  const initialCategory = new URLSearchParams(window.location.search).get('category') ?? 'all';
  const hasInitialCategory = filters.some(
    (filter) => filter.dataset.category?.toLowerCase() === initialCategory.toLowerCase()
  );
  showAllCategories = initialCategory !== 'all';
  updateVisibleCategories();
  setActiveCategory(hasInitialCategory ? initialCategory : 'all', false);
</script>
