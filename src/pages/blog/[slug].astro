---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { profile } from '../../data/profile';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const readingTime = Math.max(
  1,
  Math.round((post.body?.trim().split(/\s+/).length ?? 0) / 200)
);

const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${post.data.title} - ${profile.siteName}`} description={post.data.description}>
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <article class="px-6 pb-20 pt-14 md:pt-20">
    <div class="mx-auto max-w-3xl">
      <a href="/blog/" class="link-arrow group">
        <Icon name="chevron-left" size={14} />
        Back to blog
      </a>

      <header class="mt-8">
        <div class="flex flex-wrap items-center gap-2">
          <span class="badge badge-primary mono">{post.data.category}</span>
          <span class="mono text-[11px] text-subtle">{formattedDate}</span>
          <span class="h-1 w-1 rounded-full bg-border"></span>
          <span class="mono text-[11px] text-subtle">{readingTime} min read</span>
        </div>

        <h1 class="mt-5 text-3xl font-semibold leading-[1.15] tracking-[-0.035em] text-text sm:text-4xl">
          {post.data.title}
        </h1>
        <p class="mt-4 text-base leading-relaxed text-muted">{post.data.description}</p>

        <div class="mt-7 flex flex-col gap-4 border-y border-border py-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-md border border-primary/25 bg-primary/10 text-primary">
              <Icon name="terminal" size={15} strokeWidth={2.2} />
            </span>
            <div>
              <p class="text-xs font-medium text-text">{profile.name}</p>
              <p class="mono text-[10px] text-subtle">@{profile.alias}</p>
            </div>
          </div>

          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag: string) => (
              <span class="badge mono">{tag}</span>
            ))}
          </div>
        </div>
      </header>

      <div class="prose-custom mt-10">
        <Content />
      </div>

      <div class="mt-12 flex flex-col gap-4 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between">
        <a href="/blog/" class="btn-secondary">
          <Icon name="chevron-left" size={14} />
          All posts
        </a>
        <a href={`mailto:${profile.email}`} class="link-arrow">
          Discuss this post
          <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const progressBar = document.getElementById('reading-progress');
  const article = document.querySelector<HTMLElement>('article');

  const updateProgress = () => {
    if (!progressBar || !article) return;

    const start = article.offsetTop - 64;
    const distance = article.offsetHeight - window.innerHeight + 64;
    const progress = distance > 0 ? (window.scrollY - start) / distance : 0;
    progressBar.style.transform = `scaleX(${Math.min(Math.max(progress, 0), 1)})`;
  };

  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);
</script>
