---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';

const metrics = [
  { label: 'Physical Hosts', value: '1', icon: 'server', bars: [38, 52, 44, 60, 48, 66, 54, 72] },
  { label: 'LXC Containers', value: '5', icon: 'layers', bars: [30, 44, 58, 40, 66, 52, 74, 62] },
  { label: 'Services', value: '12+', icon: 'container', bars: [42, 36, 56, 64, 48, 70, 58, 80] },
  { label: 'Domains', value: '5+', icon: 'globe', bars: [34, 50, 42, 58, 66, 52, 68, 60] },
];

const hardware = [
  { label: 'CPU', value: 'Intel Core i5-1250P' },
  { label: 'Cores', value: '12 (4P + 8E)' },
  { label: 'Threads', value: '16' },
  { label: 'Memory', value: '24 GB RAM' },
  { label: 'Storage', value: '1 TB SSD' },
  { label: 'Host OS', value: 'Windows 11 Pro' },
  { label: 'Hypervisor', value: 'VMware Workstation' },
  { label: 'Lab Stack', value: 'Proxmox VE + LXC' },
];

const techStack = [
  'Windows',
  'VMware Workstation',
  'Proxmox VE',
  'Docker',
  'Nginx',
  'MariaDB',
  'Prometheus',
  'Grafana',
  'Ansible',
  'Cloudflare Tunnel',
  'Hermes AI',
];

const services = [
  {
    icon: 'cloud',
    name: 'Cloudflare Tunnel',
    description: 'Securely exposes internal services without opening inbound ports.',
  },
  {
    icon: 'globe',
    name: 'Nginx Web Layer',
    description: 'Reverse proxy and web serving layer for internal applications.',
  },
  {
    icon: 'container',
    name: 'Docker Services',
    description: 'Containerized applications and supporting services running inside Proxmox.',
  },
  {
    icon: 'database',
    name: 'MariaDB',
    description: 'Central database service used by self-hosted applications.',
  },
  {
    icon: 'activity',
    name: 'Prometheus + Grafana',
    description: 'Metrics collection and dashboards for homelab services and infrastructure.',
  },
  {
    icon: 'terminal',
    name: 'Hermes AI',
    description: 'Personal AI experimentation environment and agent platform.',
  },
];
---

<BaseLayout
  title={`Homelab - ${profile.siteName}`}
  description="Self-hosted Proxmox, Docker, and Cloudflare Tunnel environment with Prometheus and Grafana observability."
>
  <section class="px-6 pb-16 pt-14 md:pb-24 md:pt-20">
    <div class="mx-auto max-w-5xl">
      <div class="border-b border-border pb-8" data-reveal>
        <p class="eyebrow eyebrow-line">02 / Infrastructure</p>
        <div class="mt-3 flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
          <div>
            <h1 class="text-4xl font-semibold tracking-[-0.04em] text-text md:text-5xl">Homelab</h1>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted sm:text-base">
              A self-hosted environment on a single Mini PC for daily work, software development,
              gaming, and infrastructure experimentation — built on Proxmox, Docker, and
              Cloudflare Tunnel.
            </p>
          </div>
          <span class="badge badge-success mono shrink-0">
            <span class="status-dot status-dot--pulse"></span>
            self-hosted
          </span>
        </div>
      </div>

      <!-- Metrics -->
      <div class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
        {metrics.map((metric, index) => (
          <div class="card group" data-reveal style={`--reveal-delay: ${index * 60}ms`}>
            <div class="flex items-start justify-between gap-3">
              <span class="icon-tile">
                <Icon name={metric.icon} size={18} />
              </span>
              <span class="mono text-[9px] uppercase tracking-[0.16em] text-subtle">snapshot</span>
            </div>
            <p class="mono mt-5 text-3xl font-semibold text-text">{metric.value}</p>
            <p class="mt-1 text-xs text-muted">{metric.label}</p>
            <div class="mt-4 flex h-6 items-end gap-1" aria-hidden="true">
              {metric.bars.map((height) => (
                <span
                  class="w-1 rounded-sm bg-primary/20 last:bg-primary/60"
                  style={`height: ${height}%`}
                ></span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Infrastructure overview -->
      <div class="mt-12" data-reveal>
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="eyebrow eyebrow-line">Topology</p>
            <h2 class="section-title mt-3">Infrastructure Overview</h2>
          </div>
          <p class="mono hidden text-[11px] text-subtle sm:block">1 host &middot; 5 LXC &middot; zero open ports</p>
        </div>

        <div class="terminal mt-5">
          <div class="terminal-bar">
            <div class="terminal-dots">
              <span class="terminal-dot terminal-dot--red"></span>
              <span class="terminal-dot terminal-dot--yellow"></span>
              <span class="terminal-dot terminal-dot--green"></span>
            </div>
            <p class="mono text-[11px] text-subtle">infrastructure.tree</p>
            <span class="mono ml-auto text-[10px] uppercase tracking-wider text-subtle">proxmox-ve</span>
          </div>
          <div class="overflow-x-auto p-5 sm:p-6">
<pre class="mono text-[11px] leading-[1.9] text-muted sm:text-xs"><code>Mini PC (Windows Host)
│
└── VMware Workstation
    │
    └── Proxmox VE
        │
        ├── LXC: Proxy
        │     └── Cloudflare Tunnel
        │
        ├── LXC: Web Application
        │     ├── Web Arpotret ( arpotret.idev-fun.org )
        │     ├── Web SiakadPT ( siakad-pt.idev-fun.org )
        │     ├── Web NecoSiakad ( neco-siakad.idev-fun.org )
        │     ├── Web Nexacampus ( nexacampus.idev-fun.org )
        │     └── Web laraflare ( laraflare.idev-fun.org )
        │
        ├── LXC: Docker
        │     ├── Applications ( N8N, Vaultwarden, Affine )
        │     ├── Monitoring ( Grafana + Prometheus )
        │     └── Supporting Services
        │
        ├── LXC: Database
        │     └── MariaDB
        │
        └── LXC: Hermes
              ├── Ansible
              └── AI Agent Platform</code></pre>
          </div>
        </div>
      </div>

      <!-- Hardware + philosophy -->
      <div class="mt-6 grid gap-5 lg:grid-cols-2">
        <div class="card" data-reveal>
          <div class="flex items-center gap-3">
            <span class="icon-tile">
              <Icon name="cpu" size={18} />
            </span>
            <div>
              <h3 class="text-sm font-medium text-text">Current Hardware</h3>
              <p class="text-xs text-muted">A single machine doing real work</p>
            </div>
          </div>

          <dl class="mt-5 divide-y divide-border border-t border-border">
            {hardware.map((item) => (
              <div class="flex items-center justify-between gap-4 py-2.5">
                <dt class="text-xs text-muted">{item.label}</dt>
                <dd class="mono text-right text-xs text-text">{item.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="card" data-reveal style="--reveal-delay: 80ms">
          <div class="flex items-center gap-3">
            <span class="icon-tile">
              <Icon name="layers" size={18} />
            </span>
            <div>
              <h3 class="text-sm font-medium text-text">Infrastructure Philosophy</h3>
              <p class="text-xs text-muted">Efficiency over expansion</p>
            </div>
          </div>

          <p class="mt-5 text-sm leading-relaxed text-muted">
            This homelab intentionally runs on a single Mini PC. Instead of expanding hardware,
            the focus is on virtualization, service isolation, and efficient resource utilization.
          </p>

          <div class="mt-5 border-t border-border pt-4">
            <p class="mono text-[10px] uppercase tracking-[0.16em] text-subtle">Same machine, multiple roles</p>
            <ul class="mt-3 grid gap-2 text-sm text-muted sm:grid-cols-2">
              {['Daily productivity', 'Software development', 'Gaming', 'Self-hosted services', 'AI experimentation'].map((item) => (
                <li class="flex items-center gap-2">
                  <Icon name="check" size={13} class="shrink-0 text-primary" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Tech stack -->
      <div class="mt-12" data-reveal>
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="eyebrow eyebrow-line">Stack</p>
            <h2 class="section-title mt-3">Technology Stack</h2>
          </div>
          <p class="mono hidden text-[11px] text-subtle sm:block">{String(techStack.length).padStart(2, '0')} tools</p>
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
          {techStack.map((tech) => (
            <span class="badge mono px-3 py-1.5">
              <span class="h-1 w-1 rounded-full bg-primary/70"></span>
              {tech}
            </span>
          ))}
        </div>
      </div>

      <!-- Services -->
      <div class="mt-12" data-reveal>
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="eyebrow eyebrow-line">Running</p>
            <h2 class="section-title mt-3">Services</h2>
            <p class="section-lede">What is actually running inside the lab.</p>
          </div>
        </div>

        <div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {services.map((service, index) => (
            <div class="card group" data-reveal style={`--reveal-delay: ${index * 60}ms`}>
              <div class="flex items-start gap-4">
                <span class="icon-tile">
                  <Icon name={service.icon} size={18} />
                </span>
                <div>
                  <h3 class="text-sm font-medium text-text">{service.name}</h3>
                  <p class="mt-1.5 text-xs leading-relaxed text-muted">{service.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-6 flex justify-center" data-reveal>
          <a href="/projects/" class="btn-secondary">
            <Icon name="arrow-up-right" size={15} />
            Projects on this lab
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
