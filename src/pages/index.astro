---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { profile, tagline } from '../data/profile';

const techStack = [
  'Linux',
  'Docker',
  'Proxmox',
  'Grafana',
  'ELK Stack',
  'Cloudflare',
  'Huawei Cloud',
  'GCP',
  'FortiGate',
  'DNS',
];

const stats = [
  { value: '4+', label: 'Years in operations' },
  { value: '12+', label: 'Self-hosted services' },
  { value: '47', label: 'GitHub OSS stars' },
];

const opsSnapshot = [
  { label: 'Observability', value: 'ELK Stack / Grafana' },
  { label: 'Cloud & Virtualization', value: 'Huawei Cloud / GCP / VMware' },
  { label: 'Network & DNS', value: 'FortiGate / F5 ZoneRunner / Cloudflare' },
];

const focusAreas = [
  {
    icon: 'activity',
    title: 'Infrastructure Monitoring',
    meta: 'ELK Stack, Grafana, Prometheus',
  },
  {
    icon: 'cloud',
    title: 'Cloud Operations',
    meta: 'Huawei Cloud, GCP, VMware vCenter',
  },
  {
    icon: 'workflow',
    title: 'DevOps & Automation',
    meta: 'Docker, GitHub Actions, Bash',
  },
  {
    icon: 'shield',
    title: 'Reliability & Incident Response',
    meta: 'Alert triage, DNS, transaction impact',
  },
  {
    icon: 'server',
    title: 'Homelab Development',
    meta: 'Proxmox, LXC, Docker, Nginx',
  },
];

const journey = [
  {
    period: 'Dec 2025 — Present',
    role: 'IT Operations Center Engineer',
    company: profile.company,
    summary: 'Provisioning cloud and virtualized servers, managing enterprise DNS and firewall access, and monitoring production services.',
    tags: ['Huawei Cloud', 'GCP', 'VMware', 'FortiGate', 'F5 ZoneRunner', 'ELK'],
    current: true,
  },
  {
    period: 'Nov 2023 — Nov 2025',
    role: 'Technical Support',
    company: 'PT Qwords Company International',
    summary: 'Administered Linux and Windows hosting servers, resolved DNS, email, and security incidents, and migrated customer services with minimal downtime.',
    tags: ['Linux', 'Windows Server', 'cPanel/WHM', 'DNS', 'Security'],
    current: false,
  },
  {
    period: 'Sep 2021 — Aug 2023',
    role: 'Computer Laboratory Technician',
    company: 'STMIK IKMI Cirebon',
    summary: 'Maintained lab infrastructure, LAN connectivity, and software for students and faculty.',
    tags: ['LAN', 'Hardware', 'Technical Support'],
    current: false,
  },
];
---

<BaseLayout title={`${profile.name} (${profile.alias}) — Cloud Infrastructure, Reliability & DevOps`}>
  <!-- Hero -->
  <section class="relative px-6 pb-10 pt-16 md:pb-14 md:pt-24">
    <div class="mx-auto max-w-5xl">
      <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
        <div data-reveal>
          <div class="flex flex-wrap items-center gap-3">
            <span class="badge badge-primary mono">
              <span class="status-dot"></span>
              {profile.role}
            </span>
            <span class="eyebrow">Cloud &middot; Reliability &middot; DevOps</span>
          </div>

          <h1 class="mt-6 text-[2.5rem] font-semibold leading-[1.05] tracking-[-0.045em] sm:text-5xl lg:text-[3.4rem]">
            Muhamad Jaya<br class="hidden sm:block" />{' '}
            Kusuma
          </h1>

          <p class="mono mt-3 text-base text-primary-bright">
            @{profile.alias}
          </p>

          <p class="mt-5 max-w-xl text-sm leading-relaxed text-muted sm:text-base">
            {tagline}
          </p>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted sm:text-base">
            {profile.role} at {profile.company} &mdash; provisioning cloud and virtualized servers,
            managing enterprise DNS and firewall access, and monitoring production services.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/projects/" class="btn-primary">
              <Icon name="folder" size={16} />
              View Projects
              <Icon name="arrow-right" size={15} class="opacity-70" />
            </a>
            <a href="/resume/" class="btn-secondary">
              <Icon name="file-text" size={16} class="text-muted" />
              Resume
            </a>
          </div>

          <div class="mt-10 grid grid-cols-3 gap-4 border-t border-border pt-6 sm:flex sm:flex-wrap sm:gap-8">
            {stats.map((stat) => (
              <div>
                <p class="mono text-xl font-semibold text-text">{stat.value}</p>
                <p class="mt-0.5 text-[11px] uppercase tracking-wider text-subtle">{stat.label}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Status panel -->
        <div class="terminal" data-reveal style="--reveal-delay: 120ms">
          <div class="terminal-bar">
            <div class="terminal-dots">
              <span class="terminal-dot terminal-dot--red"></span>
              <span class="terminal-dot terminal-dot--yellow"></span>
              <span class="terminal-dot terminal-dot--green"></span>
            </div>
            <p class="mono text-[11px] text-subtle">{profile.alias}@hq — status</p>
            <span class="mono ml-auto flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-success">
              <span class="status-dot"></span>
              snapshot
            </span>
          </div>

          <div class="p-5 sm:p-6">
            <div class="flex items-center justify-between gap-4">
              <p class="mono text-[11px] text-subtle">$ systemctl status --focus</p>
              <span class="badge badge-success mono text-[10px]">in use</span>
            </div>

            <div class="mt-5 space-y-2">
              {opsSnapshot.map((item) => (
                <div class="group flex items-center gap-3 rounded-lg border border-transparent px-2.5 py-2.5 transition-colors hover:border-border hover:bg-white/[0.02]">
                  <span class="status-dot"></span>
                  <div class="min-w-0 flex-1">
                    <p class="text-[13px] font-medium text-text">{item.label}</p>
                    <p class="mono mt-0.5 text-[11px] text-subtle">{item.value}</p>
                  </div>
                  <span class="mono text-[10px] uppercase tracking-wider text-success/80">active</span>
                </div>
              ))}
            </div>

            <div class="mt-5 border-t border-border pt-4">
              <p class="mono flex items-center gap-2 text-[11px] text-subtle">
                <span class="text-primary">$</span>
                cat current-focus.txt
                <span class="inline-block h-3.5 w-1.5 animate-pulse bg-primary/70"></span>
              </p>
              <p class="mt-2.5 text-sm leading-relaxed text-muted">
                Cloud provisioning, observability, and reliable operations across production and homelab systems.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Tech stack -->
      <div class="mt-12 flex flex-col gap-4 border-t border-border pt-6 sm:flex-row sm:items-center" data-reveal>
        <span class="eyebrow shrink-0">Core stack</span>
        <div class="flex flex-wrap gap-2">
          {techStack.map((tech) => (
            <span class="badge mono">{tech}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Current focus -->
  <section class="px-6 py-12 md:py-16">
    <div class="mx-auto max-w-5xl">
      <div class="flex items-end justify-between gap-6" data-reveal>
        <div>
          <p class="eyebrow eyebrow-line">01 / Focus</p>
          <h2 class="section-title mt-3">Current Focus</h2>
          <p class="section-lede">The areas I'm actively working on and sharpening right now.</p>
        </div>
        <a href="/now/" class="link-arrow hidden shrink-0 sm:inline-flex">
          See /now
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {focusAreas.map((area, index) => (
          <div class="card group" data-reveal style={`--reveal-delay: ${index * 60}ms`}>
            <div class="flex items-start gap-4">
              <span class="icon-tile">
                <Icon name={area.icon} size={18} />
              </span>
              <div>
                <h3 class="text-sm font-medium text-text">{area.title}</h3>
                <p class="mt-1.5 text-xs leading-relaxed text-muted">{area.meta}</p>
              </div>
            </div>
          </div>
        ))}

        <a href="/now/" class="card card-link group border-dashed" data-reveal style="--reveal-delay: 300ms">
          <div class="flex items-start gap-4">
            <span class="icon-tile">
              <Icon name="arrow-up-right" size={18} />
            </span>
            <div>
              <h3 class="text-sm font-medium text-text">What's running now</h3>
              <p class="mt-1.5 text-xs leading-relaxed text-muted">
                Current work, learning, and projects in one snapshot.
              </p>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Journey -->
  <section class="px-6 py-12 md:py-16">
    <div class="mx-auto max-w-5xl">
      <div data-reveal>
        <p class="eyebrow eyebrow-line">02 / Journey</p>
        <h2 class="section-title mt-3">Journey</h2>
        <p class="section-lede">From lab support to cloud and infrastructure operations.</p>
      </div>

      <div class="mt-8 grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="card h-fit lg:sticky lg:top-24" data-reveal>
          <p class="mono text-[11px] uppercase tracking-[0.16em] text-subtle">The path</p>
          <p class="mt-4 text-lg font-medium leading-snug text-text">
            Started in technical support. Grew into cloud operations.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Every role added another layer: from maintaining computer labs and hosting customers,
            to monitoring production infrastructure and operating cloud environments.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            <span class="badge">Support</span>
            <span class="badge">Linux</span>
            <span class="badge">Cloud</span>
            <span class="badge">Operations</span>
          </div>
          <a href="/resume/" class="link-arrow mt-6">
            View full resume
            <Icon name="arrow-right" size={14} />
          </a>
        </div>

        <div>
          {journey.map((item, index) => (
            <div class="relative flex gap-5 pb-8 last:pb-0" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
              <div class="flex flex-col items-center">
                {item.current ? (
                  <span class="mt-1 flex h-3.5 w-3.5 items-center justify-center rounded-full border border-primary/40 bg-primary/15">
                    <span class="h-1.5 w-1.5 rounded-full bg-primary shadow-[0_0_8px_rgba(91,156,246,0.8)]"></span>
                  </span>
                ) : (
                  <span class="mt-1 flex h-3.5 w-3.5 items-center justify-center rounded-full border border-border bg-elevated">
                    <span class="h-1.5 w-1.5 rounded-full bg-subtle"></span>
                  </span>
                )}
                <span class="mt-2 w-px flex-1 bg-gradient-to-b from-border to-transparent"></span>
              </div>

              <div class="min-w-0 pb-2">
                <div class="flex flex-wrap items-center gap-2">
                  <p class="mono text-[11px] uppercase tracking-wider text-subtle">{item.period}</p>
                  {item.current && <span class="badge badge-success mono text-[10px]">current</span>}
                </div>
                <h3 class="mt-1.5 text-base font-semibold text-text">{item.role}</h3>
                <p class="text-sm text-muted">{item.company}</p>
                <p class="mt-2 text-sm leading-relaxed text-muted">{item.summary}</p>
                {item.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {item.tags.map((tag) => (
                      <span class="badge mono">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="px-6 pb-20 pt-4 md:pb-24">
    <div class="mx-auto max-w-5xl">
      <div class="relative overflow-hidden rounded-2xl border border-border bg-card p-8 md:p-10" data-reveal>
        <div class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-primary/10 blur-3xl"></div>
        <div class="relative flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div>
            <p class="eyebrow eyebrow-line">Contact</p>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight text-text">Let's talk infrastructure.</h2>
            <p class="mt-2 max-w-md text-sm leading-relaxed text-muted">
              For questions, collaboration, or just talking shop about systems, cloud, and automation.
            </p>
          </div>
          <a href={`mailto:${profile.email}`} class="btn-primary shrink-0">
            Say hello
            <Icon name="arrow-up-right" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
